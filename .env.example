PORT=5000
NODE_ENV=development
HOST=localhost
BASE_URL=http://localhost:5000
BASE_URL_TWO=http://localhost:5000
API_PREFIX=/api/V1

MONGO_URI=mongodb://localhost:27017/al_bayyan

JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Al Bayyan's own Shopify store — to be supplied later, do not fabricate
SHOPIFY_BASE_URL=
SHOPIFY_TOKEN=
SHOPIFY_ADMIN_API=

# To be supplied later - delivery-agent (staff) app's OneSignal project
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Customer app's own OneSignal project - separate from the agent app above.
# Falls back to ONESIGNAL_APP_ID/ONESIGNAL_REST_API_KEY if left blank (fine for
# early testing since external-user-id namespaces don't collide, but the
# customer app should get its own registered OneSignal app before production).
ONESIGNAL_CUSTOMER_APP_ID=
ONESIGNAL_CUSTOMER_REST_API_KEY=

# Google Maps Geocoding API — to be supplied later, do not fabricate
GOOGLE_MAPS_API_KEY=

# Shared static API key for the external customer-facing tracking app (live order tracking).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: the exact same value must be manually placed in the customer app's own .env
# (separate codebase, not managed here) — this is a manual handoff step.
TRACKING_API_KEY=

# Brevo transactional email (delivery OTP) — to be supplied later, do not fabricate
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Al Bayyan
